```plantuml
@startuml
title Smart Campus - Domain Class Diagram

class Student {
    - studentId: String
    - name: String
    - email: String
    --
    + bookRoom(room: Room, startTime: DateTime, endTime: DateTime): Booking
    + cancelBooking(booking: Booking): void
}

class Room {
    - roomId: String
    - name: String
    - capacity: Integer
    - isBlocked: Boolean
    --
    + isAvailable(startTime: DateTime, endTime: DateTime): Boolean
    + block(): void
    + unblock(): void
}

class Booking {
    - bookingId: String
    - startTime: DateTime
    - endTime: DateTime
    - status: BookingStatus
    --
    + cancel(): void
    + overlaps(other: Booking): Boolean
}

enum BookingStatus {
    ACTIVE
    CANCELLED
}

Student "1" -- "0..*" Booking : makes
Room "1" -- "0..*" Booking : has

note right of Booking
R2:
A booking connects exactly one
student with exactly one room
for a specified time interval.
end note

@enduml
